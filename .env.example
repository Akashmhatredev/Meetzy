# ---------------------------------------------------------------------
# Browser (Vite) variables. Everything prefixed VITE_ ships to the browser,
# so only public, restricted keys belong here.
# ---------------------------------------------------------------------

# Supabase project URL and anon (public) key: Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Maps browser key. Restrict it in Google Cloud Console to:
#   Application restriction: HTTP referrers (your domains + localhost:5190)
#   API restriction: Maps JavaScript API, Places API (New), Geocoding API
VITE_GOOGLE_MAPS_API_KEY=

# Optional: a Map ID from Google Cloud (Map Management). Advanced markers
# need one; without it Meetzy uses Google's DEMO_MAP_ID (fine for dev).
VITE_GOOGLE_MAPS_MAP_ID=

# ---------------------------------------------------------------------
# Server-side secrets: NEVER put these in this file or any VITE_ variable.
# Set them as Supabase Edge Function secrets instead:
#
#   npx supabase secrets set GOOGLE_MAPS_SERVER_KEY=... ALLOWED_ORIGINS=https://your-app.vercel.app
#
# GOOGLE_MAPS_SERVER_KEY  Google key restricted to Places API (New) + Routes API
# ALLOWED_ORIGINS         Comma-separated origins allowed to call the functions
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are provided to functions by Supabase.
# ---------------------------------------------------------------------
